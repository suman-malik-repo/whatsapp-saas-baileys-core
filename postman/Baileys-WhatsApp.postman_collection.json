{
  "info": {
    "name": "Baileys WhatsApp message API",
    "description": "Send messages by phone number. Set baseUrl, apiKey and phone before sending. Replace example.com media URLs with direct public file URLs. The upload example requires selecting a local file. All sends are POST and use x-api-key authentication. Sends now return 202 Accepted with a local jobId. The response script saves jobId for Get message status. A 202 is not confirmed delivery. Use wait=true or QUEUE_API_MODE=wait only for bounded migration compatibility; always poll the same accepted job.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "YOUR_API_KEY",
      "type": "string"
    },
    {
      "key": "phone",
      "value": "12025550123",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "JOB_ID_FROM_SEND",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Text",
      "request": {
        "description": "Send one text message. Required: phone (string with country code), message (nonblank string, at most 4096 code units). type may be omitted or set to text. Set collection variables before sending.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"message\": \"Hello from Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body;",
              "try { body = pm.response.json(); } catch (_) {}",
              "if (body && body.jobId) pm.collectionVariables.set('jobId', body.jobId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Image URL",
      "request": {
        "description": "Send a JPEG, PNG, or WebP image from a public direct file URL. Required: phone, type=image, url. Optional: caption (at most 1024 code units), mimetype, viewOnce (boolean). Maximum file size: 10 MiB. Replace the example.com URL.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"image\",\n  \"url\": \"https://example.com/photo.jpg\",\n  \"caption\": \"Here is the photo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body;",
              "try { body = pm.response.json(); } catch (_) {}",
              "if (body && body.jobId) pm.collectionVariables.set('jobId', body.jobId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Video URL",
      "request": {
        "description": "Send a prepared MP4 video from a public direct file URL. Required: phone, type=video, url. Optional: caption, mimetype, gifPlayback, viewOnce. Boolean flags use JSON booleans. Maximum file size: 50 MiB. gifPlayback requests GIF-style playback; it does not convert a GIF. Replace the placeholder URL.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"video\",\n  \"url\": \"https://example.com/clip.mp4\",\n  \"caption\": \"Here is the video\",\n  \"gifPlayback\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body;",
              "try { body = pm.response.json(); } catch (_) {}",
              "if (body && body.jobId) pm.collectionVariables.set('jobId', body.jobId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Audio URL",
      "request": {
        "description": "Send audio from a public direct file URL. Required: phone, type=audio, url. Optional: mimetype, ptt, seconds (integer from 0 through 86400), viewOnce. Duration is detected when omitted. ptt=true requires actual Ogg/Opus content. Captions are not accepted for audio. Maximum file size: 16 MiB. Replace the placeholder URL.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"audio\",\n  \"url\": \"https://example.com/audio.mp3\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
