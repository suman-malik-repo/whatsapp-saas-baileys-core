            ]
          }
        }
      ]
    },
    {
      "name": "Sticker URL",
      "request": {
        "description": "Send a prepared WhatsApp-compatible WebP sticker up to 512 pixels per side. Required: phone, type=sticker, url. Optional: mimetype, isAnimated. isAnimated must match the file and is detected when omitted. Captions and viewOnce are not accepted. Maximum file size: 1 MiB. Replace the placeholder URL.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"sticker\",\n  \"url\": \"https://example.com/sticker.webp\",\n  \"isAnimated\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body;",
              "try { body = pm.response.json(); } catch (_) {}",
              "if (body && body.jobId) pm.collectionVariables.set('jobId', body.jobId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Static location",
      "request": {
        "description": "Send one static location pin. Required: phone, type=location, location.latitude (number -90 through 90), location.longitude (number -180 through 180). Optional inside location: name, address. Coordinates must be JSON numbers, not strings. This does not start live location sharing.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"location\",\n  \"location\": {\n    \"latitude\": 22.5726,\n    \"longitude\": 88.3639,\n    \"name\": \"Meeting point\",\n    \"address\": \"Kolkata, India\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body;",
              "try { body = pm.response.json(); } catch (_) {}",
              "if (body && body.jobId) pm.collectionVariables.set('jobId', body.jobId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Contact cards",
      "request": {
        "description": "Send 1 to 20 contact cards. Required: recipient phone, type=contacts, contacts array with name and phone strings for each card. Optional per contact: organization, email. Optional top-level displayName labels multiple cards. Edit the card's own number separately from the recipient collection variable. The server generates vCards.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"contacts\",\n  \"contacts\": [\n    {\n      \"name\": \"Alex Example\",\n      \"phone\": \"12025550124\",\n      \"organization\": \"Example Company\",\n      \"email\": \"alex@example.com\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body;",
              "try { body = pm.response.json(); } catch (_) {}",
              "if (body && body.jobId) pm.collectionVariables.set('jobId', body.jobId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Poll",
      "request": {
        "description": "Send a poll. Required: phone, type=poll, poll.name, poll.options (2 to 12 distinct nonblank strings). Optional poll.selectableCount is an integer from 1 through the option count, default 1. Names are at most 256 code units; options at most 100 each. Options must be unique ignoring case and surrounding whitespace. This request does not collect or query votes.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"poll\",\n  \"poll\": {\n    \"name\": \"Which time works for you?\",\n    \"options\": [\n      \"Morning\",\n      \"Afternoon\",\n      \"Evening\"\n    ],\n    \"selectableCount\": 1\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body;",
              "try { body = pm.response.json(); } catch (_) {}",
              "if (body && body.jobId) pm.collectionVariables.set('jobId', body.jobId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Image file upload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "description": "Select a JPEG, PNG, or WebP image in the file row (maximum 10 MiB). Leave Content-Type unset so Postman supplies the multipart boundary. Exactly one file named file is required. Multipart flags use lowercase text true/false. To adapt this request to another media type, also delete or disable incompatible optional rows: remove caption for audio/voice; remove viewOnce for document; remove both for sticker. See docs/MESSAGE_API.md for all per-type fields and limits.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "phone",
              "value": "{{phone}}",
              "type": "text"
            },
            {
              "key": "type",
              "value": "image",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "caption",
              "value": "Uploaded from Postman",
              "type": "text"
            },
            {
              "key": "viewOnce",
              "value": "false",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body;",
              "try { body = pm.response.json(); } catch (_) {}",
              "if (body && body.jobId) pm.collectionVariables.set('jobId', body.jobId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get message status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/messages/{{jobId}}",
        "description": "Poll a job returned by POST /api/send. The send response saves jobId automatically. Authenticated response: {success:true,job:{jobId,status,attempts,timestamps,messageId?,error?}}. sent does not mean delivered; read requires a reliable acknowledgement. A missing retained record returns404 and does not prove that no message was sent."
      }
    },
    {
      "name": "Queue statistics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/queue/stats",
        "description": "Authenticated local queue/staging counters and connection state. In-memory data is not durable across restarts. No recipient or message content is included."
      }
    },
    {
      "name": "Process liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/live",
        "description": "Public process liveness. Returns200 while the HTTP process is reachable, even when WhatsApp is disconnected."
      }
    },
    {
      "name": "Worker readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ready",
        "description": "Public WhatsApp and admission readiness. Returns200 when ready,503 when disconnected, full, or draining. No keys, QR codes, phone numbers or message content."
      }
    },
    {
      "name": "WhatsApp ping",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/ping",
        "description": "Existing public WhatsApp readiness endpoint. Returns200 when connected,503 otherwise. Queue capacity is reported through /ready and authenticated stats."
      }
    }
  ]
}
