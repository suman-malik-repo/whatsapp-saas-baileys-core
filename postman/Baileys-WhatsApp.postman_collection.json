    },
    {
      "name": "Document URL",
      "request": {
        "description": "Send a document from a public direct file URL. Required: phone, type=document, url. Optional: caption, mimetype, fileName. fileName defaults to the URL basename; supply a filename without directory separators if needed. Maximum file size: 100 MiB. HTML preview/login pages are rejected. Replace the placeholder URL.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"document\",\n  \"url\": \"https://example.com/invoice.pdf\",\n  \"fileName\": \"invoice.pdf\",\n  \"caption\": \"Your invoice\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
        {
          "listen": "test",
