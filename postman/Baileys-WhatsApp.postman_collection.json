            ]
          }
        }
      ]
    },
    {
      "name": "Voice note URL",
      "request": {
        "description": "Send an Ogg/Opus voice note from a public direct file URL. Required: phone, type=voice, url. Optional: mimetype, seconds, viewOnce. ptt is set automatically; do not add it as a field for this type. No automatic transcoding or captions. Maximum file size: 16 MiB. Replace the placeholder URL.",
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"type\": \"voice\",\n  \"url\": \"https://example.com/voice.opus\",\n  \"seconds\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/send"
      },
      "event": [
