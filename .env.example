# Local standalone mode preserves /api/send and /qr.
MANAGED_MODE=false
PORT=3000
# Set a unique API_KEY for standalone deployments.
# API_KEY=

# Managed Render mode: configure these as Render environment secrets/settings.
# MANAGED_MODE=true
# WORKER_ID=worker-generated-by-gateway
# WORKER_SECRET=at-least-32-random-bytes-generated-by-gateway
# GATEWAY_URL=https://your-gateway-worker.workers.dev
# Manual Render testing without a disk (state is lost on replacement/restart):
# MANAGED_STORAGE_MODE=ephemeral
# DATA_DIR=/tmp/whatsapp-data
# Optional paid service with an actual mounted persistent disk instead:
# MANAGED_STORAGE_MODE=persistent
# DATA_DIR=/var/data
# Storage mode describes the hosting guarantee; it does not attach storage.
# Optional extra gateway-controlled R2 origins, comma separated. Public SaaS
# users cannot supply these origins. The gateway's own origin is always allowed.
# MEDIA_ALLOWED_ORIGINS=https://your-r2-api-origin.example
# Bound retained receipts/statuses to your plan volume and service memory.
# MANAGED_JOURNAL_MAX_JOBS=10000
# MANAGED_JOURNAL_MAX_EVENTS=20000
# MANAGED_JOURNAL_MAX_BYTES=16777216
